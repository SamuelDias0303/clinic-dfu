rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tokenRoles() {
      return signedIn() && request.auth.token.roles is list ? request.auth.token.roles : [];
    }

    function isAdminGlobal() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || tokenRoles().hasAny(['ADMIN_GLOBAL'])
        );
    }

    function memberPath(whitelabelId) {
      return /databases/$(database)/documents/whitelabels/$(whitelabelId)/members/$(request.auth.uid);
    }

    function memberExists(whitelabelId) {
      return signedIn() && exists(memberPath(whitelabelId));
    }

    function memberData(whitelabelId) {
      return get(memberPath(whitelabelId)).data;
    }

    function isActiveMember(whitelabelId) {
      return memberExists(whitelabelId)
        && memberData(whitelabelId).status == 'ATIVO';
    }

    function memberRoles(whitelabelId) {
      return isActiveMember(whitelabelId) && memberData(whitelabelId).roles is list
        ? memberData(whitelabelId).roles
        : [];
    }

    function hasTenantRole(whitelabelId, roles) {
      return memberRoles(whitelabelId).hasAny(roles);
    }

    function isGestor(whitelabelId) {
      return hasTenantRole(whitelabelId, ['GESTOR']);
    }

    function isRecepcao(whitelabelId) {
      return hasTenantRole(whitelabelId, ['REPCAO']);
    }

    function isTerapeuta(whitelabelId) {
      return hasTenantRole(whitelabelId, ['TERAPEUTA']);
    }

    function tenantFieldIsValid(whitelabelId) {
      return !('whitelabelId' in request.resource.data)
        || request.resource.data.whitelabelId == whitelabelId;
    }

    function existingTenantFieldIsValid(whitelabelId) {
      return !('whitelabelId' in resource.data)
        || resource.data.whitelabelId == whitelabelId;
    }

    function isOwnMemberDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // --- Leads vindos de site publico -------------------------------------
    //
    // ATENCAO: `leads` e a UNICA colecao do sistema que aceita escrita sem
    // autenticacao. Por isso a validacao abaixo trabalha com lista fechada de
    // campos permitidos, nao com lista de proibidos. Campo novo precisa ser
    // adicionado aqui, em `src/types.ts` (Lead / LEAD_LIMITS) e no contrato
    // espelhado da landing page.
    //
    // Nao existe leitura publica: quem envia nao recupera nada de volta.

    function leadAllowedKeys() {
      return [
        'whitelabelId', 'origem', 'responsavel', 'whatsapp', 'bebeNome',
        'bebeIdadeFaixa', 'preocupacoes', 'outroMotivo', 'periodoContato',
        'observacoes', 'endereco', 'consentimento', 'consentimentoTexto',
        'status', 'createdAt'
      ];
    }

    function leadRequiredKeys() {
      return [
        'whitelabelId', 'origem', 'responsavel', 'whatsapp', 'bebeIdadeFaixa',
        'preocupacoes', 'observacoes', 'consentimento',
        'consentimentoTexto', 'status', 'createdAt'
      ];
    }

    function enderecoAllowedKeys() {
      return ['cep', 'logradouro', 'numero', 'complemento', 'bairro', 'cidade', 'estado'];
    }

    // Endereco opcional, campo a campo — nenhum sub-campo e obrigatorio.
    // So valida tipo/tamanho de quem foi enviado.
    function isValidEndereco(endereco) {
      return endereco is map
        && endereco.keys().hasOnly(enderecoAllowedKeys())
        && (!('cep' in endereco) || (endereco.cep is string && endereco.cep.size() <= 9))
        && (!('logradouro' in endereco) || (endereco.logradouro is string && endereco.logradouro.size() <= 200))
        && (!('numero' in endereco) || (endereco.numero is string && endereco.numero.size() <= 20))
        && (!('bairro' in endereco) || (endereco.bairro is string && endereco.bairro.size() <= 120))
        && (!('cidade' in endereco) || (endereco.cidade is string && endereco.cidade.size() <= 120))
        && (!('estado' in endereco) || (endereco.estado is string && endereco.estado.size() == 2))
        && (!('complemento' in endereco)
            || (endereco.complemento is string && endereco.complemento.size() <= 120));
    }

    function isValidLeadCreate(whitelabelId) {
      let data = request.resource.data;
      return data.keys().hasOnly(leadAllowedKeys())
        && data.keys().hasAll(leadRequiredKeys())
        && data.whitelabelId == whitelabelId
        && data.status == 'NOVO'
        && data.consentimento == true
        && data.createdAt == request.time
        && data.origem is string
        && data.origem.size() > 0 && data.origem.size() <= 60
        && data.responsavel is string
        && data.responsavel.size() > 1 && data.responsavel.size() <= 120
        && data.whatsapp is string
        && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 25
        && data.consentimentoTexto is string
        && data.consentimentoTexto.size() > 0 && data.consentimentoTexto.size() <= 500
        && data.bebeIdadeFaixa in ['0-1m', '1-3m', '3-6m', '6-12m', '12-24m', 'outra']
        && data.preocupacoes is list
        && data.preocupacoes.size() > 0 && data.preocupacoes.size() <= 10
        && data.observacoes is string
        && data.observacoes.size() > 0 && data.observacoes.size() <= 1000
        && (!('endereco' in data) || isValidEndereco(data.endereco))
        && (!('bebeNome' in data)
            || (data.bebeNome is string && data.bebeNome.size() <= 120))
        && (!('periodoContato' in data)
            || data.periodoContato in ['MANHA', 'TARDE', 'NOITE', 'QUALQUER'])
        // "Outro motivo" marcado exige explicar qual — nao entra vazio.
        && (!data.preocupacoes.hasAny(['Outro motivo'])
            || ('outroMotivo' in data && data.outroMotivo is string
                && data.outroMotivo.size() > 0 && data.outroMotivo.size() <= 200))
        && (!('outroMotivo' in data)
            || (data.outroMotivo is string && data.outroMotivo.size() <= 200));
    }

    // O operador tria o lead, mas nao reescreve o que a pessoa enviou —
    // preserva a integridade da prova de consentimento.
    function isValidLeadTriage() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'notasInternas', 'convertedPatientId', 'updatedAt', 'whitelabelId'])
        && request.resource.data.status in
             ['NOVO', 'EM_CONTATO', 'AGENDADO', 'CONVERTIDO', 'DESCARTADO']
        && (!('notasInternas' in request.resource.data)
            || (request.resource.data.notasInternas is string
                && request.resource.data.notasInternas.size() <= 2000));
    }

    // --- Depoimentos vindos da pagina publica /depoimento ------------------
    //
    // Junto com `leads`, e a UNICA outra colecao do sistema que aceita escrita
    // sem autenticacao. Mesma logica: lista fechada de campos permitidos.
    // Campo novo precisa ser adicionado aqui, em `src/types.ts`
    // (TestimonialPendente / TESTIMONIAL_LIMITS) e no contrato espelhado da
    // landing page. Nao existe leitura publica.

    function testimonialAllowedKeys() {
      return [
        'whitelabelId', 'origem', 'nome', 'papel', 'texto', 'whatsapp',
        'bebeNome', 'bebeIdadeValor', 'bebeIdadeUnidade', 'status', 'createdAt'
      ];
    }

    function testimonialRequiredKeys() {
      return ['whitelabelId', 'origem', 'nome', 'papel', 'texto', 'status', 'createdAt'];
    }

    function isValidTestimonialCreate(whitelabelId) {
      let data = request.resource.data;
      return data.keys().hasOnly(testimonialAllowedKeys())
        && data.keys().hasAll(testimonialRequiredKeys())
        && data.whitelabelId == whitelabelId
        && data.status == 'PENDENTE'
        && data.createdAt == request.time
        && data.origem is string
        && data.origem.size() > 0 && data.origem.size() <= 60
        && data.nome is string
        && data.nome.size() > 1 && data.nome.size() <= 120
        && data.papel in ['Mãe', 'Pai', 'Responsável']
        && data.texto is string
        && data.texto.size() > 1 && data.texto.size() <= 1000
        && (!('whatsapp' in data)
            || (data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 25))
        && (!('bebeNome' in data)
            || (data.bebeNome is string && data.bebeNome.size() <= 120))
        && (!('bebeIdadeValor' in data)
            || (data.bebeIdadeValor is number && data.bebeIdadeValor >= 0 && data.bebeIdadeValor <= 200))
        && (!('bebeIdadeUnidade' in data)
            || data.bebeIdadeUnidade in ['meses', 'anos']);
    }

    // A moderacao so muda o status — nao reescreve o que a pessoa enviou.
    function isValidTestimonialTriage() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt', 'whitelabelId'])
        && request.resource.data.status in ['PENDENTE', 'APROVADO', 'REJEITADO'];
    }

    // --- Perfil do usuario -------------------------------------------------
    //
    // `AuthContext` confia em dois campos de `users/{uid}` para decidir
    // privilegio:
    //
    //   roles            -> entra direto na lista de papeis do usuario
    //   provisioningMode -> decide o provisionamento de workspace e, com
    //                       memberships vazias, empurra a conta para o
    //                       fallback `legacy-default`
    //
    // Como `isOwnMemberDoc` e apenas `uid == userId`, permitir que a pessoa
    // escreva esses campos livremente no proprio documento seria auto-promocao
    // a ADMIN_GLOBAL.
    //
    // Existe uma excecao legitima: `personalWorkspaceService` provisiona o
    // workspace individual em nome do proprio usuario e grava `users/{uid}` com
    // valores fixos. Por isso a regra restringe VALOR, nao apenas chave —
    // mesmo padrao ja usado em `whitelabels/individual_{uid}` logo abaixo.
    // `TERAPEUTA` e o papel que a conta receberia de qualquer forma, entao
    // permitir esse valor exato nao abre escalacao.
    //
    // O Admin SDK ignora estas regras, entao `npm run admin:grant` continua
    // funcionando normalmente.

    function profilePrivilegedFields() {
      return ['roles', 'provisioningMode'];
    }

    function isPersonalWorkspaceBootstrap() {
      return request.resource.data.roles == ['TERAPEUTA']
        && request.resource.data.provisioningMode == 'PERSONAL_WORKSPACE';
    }

    function selfProfileCreateIsSafe() {
      return !request.resource.data.keys().hasAny(profilePrivilegedFields())
        || isPersonalWorkspaceBootstrap();
    }

    function selfProfileUpdateIsSafe() {
      return !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(profilePrivilegedFields())
        || isPersonalWorkspaceBootstrap();
    }

    function therapistCanAccessPatient(whitelabelId) {
      return isTerapeuta(whitelabelId)
        && (
          resource.data.therapistId == request.auth.token.email
          || resource.data.therapistId == request.auth.uid
          || (
            memberData(whitelabelId).therapistId is string
            && resource.data.therapistId == memberData(whitelabelId).therapistId
          )
        );
    }

    function therapistCanWritePatient(whitelabelId) {
      return isTerapeuta(whitelabelId)
        && (
          request.resource.data.therapistId == request.auth.token.email
          || request.resource.data.therapistId == request.auth.uid
          || (
            memberData(whitelabelId).therapistId is string
            && request.resource.data.therapistId == memberData(whitelabelId).therapistId
          )
        );
    }

    match /users/{userId} {
      allow read: if isAdminGlobal() || isOwnMemberDoc(userId);
      allow create: if isAdminGlobal()
        || (isOwnMemberDoc(userId) && selfProfileCreateIsSafe());
      allow update: if isAdminGlobal()
        || (isOwnMemberDoc(userId) && selfProfileUpdateIsSafe());
      allow delete: if isAdminGlobal();
    }

    // Compatibilidade temporaria: a colecao legada ainda alimenta o backoffice.
    // Remover depois que `clients` for migrada para `whitelabels`.
    match /clients/{clientId} {
      allow read: if isAdminGlobal() || isActiveMember(clientId);
      allow create, delete: if isAdminGlobal();
      allow update: if isAdminGlobal()
        || (
          isGestor(clientId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'updatedAt'])
          && request.resource.data.settings.diff(resource.data.settings).affectedKeys().hasOnly(['therapistSpecialties'])
          && request.resource.data.settings.therapistSpecialties is list
        );
    }

    match /invites/{inviteId} {
      allow read: if true;
      allow create: if isAdminGlobal()
        || (
          signedIn()
          && request.resource.data.whitelabelId is string
          && isGestor(request.resource.data.whitelabelId)
          && request.resource.data.roles is list
          && request.resource.data.roles.hasOnly(['REPCAO', 'TERAPEUTA'])
        );
      allow delete: if isAdminGlobal();
      allow update: if isAdminGlobal()
        || (
          signedIn()
          && resource.data.email == request.auth.token.email
          && request.resource.data.email == resource.data.email
          && request.resource.data.whitelabelId == resource.data.whitelabelId
          && request.resource.data.roles == resource.data.roles
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt'])
          && request.resource.data.status == 'ACEITO'
        );
    }

    // Necessario para o AuthContext carregar memberships via collectionGroup('members').
    match /{path=**}/members/{userId} {
      allow read: if signedIn()
        && (
          isAdminGlobal()
          || userId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || resource.data.email == request.auth.token.email
        );
    }

    match /whitelabels/{whitelabelId} {
      allow read: if isAdminGlobal() || isActiveMember(whitelabelId);
      allow create: if isAdminGlobal()
        || (
          signedIn()
          && whitelabelId == 'individual_' + request.auth.uid
          && request.resource.data.workspaceType == 'INDIVIDUAL'
          && request.resource.data.ownerUserId == request.auth.uid
          && request.resource.data.plan == 'Individual'
        );
      allow update, delete: if isAdminGlobal();

      match /members/{userId} {
        allow read: if isAdminGlobal() || isGestor(whitelabelId) || isOwnMemberDoc(userId);
        allow create: if isAdminGlobal()
          || (
            signedIn()
            && whitelabelId == 'individual_' + request.auth.uid
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'ATIVO'
            && request.resource.data.roles is list
            && request.resource.data.roles.hasOnly(['TERAPEUTA'])
          )
          || (
            isGestor(whitelabelId)
            && request.resource.data.roles is list
            && request.resource.data.roles.hasOnly(['REPCAO', 'TERAPEUTA'])
          )
          || (
            signedIn()
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'ATIVO'
            && request.resource.data.invitationToken is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.invitationToken))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invitationToken)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invitationToken)).data.whitelabelId == whitelabelId
            && get(/databases/$(database)/documents/invites/$(request.resource.data.invitationToken)).data.roles == request.resource.data.roles
          );
        allow update: if isAdminGlobal()
          || (
            isGestor(whitelabelId)
            && request.resource.data.roles is list
            && request.resource.data.roles.hasOnly(['REPCAO', 'TERAPEUTA'])
          )
          || (
            signedIn()
            && (
              userId == request.auth.uid
              || resource.data.email == request.auth.token.email
            )
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.status == 'ATIVO'
            && resource.data.invitationToken is string
            && exists(/databases/$(database)/documents/invites/$(resource.data.invitationToken))
            && get(/databases/$(database)/documents/invites/$(resource.data.invitationToken)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/invites/$(resource.data.invitationToken)).data.whitelabelId == whitelabelId
            && get(/databases/$(database)/documents/invites/$(resource.data.invitationToken)).data.roles == request.resource.data.roles
          );
        allow delete: if isAdminGlobal()
          || isGestor(whitelabelId)
          || (
            signedIn()
            && resource.data.email == request.auth.token.email
            && resource.data.invitationToken is string
            && exists(/databases/$(database)/documents/invites/$(resource.data.invitationToken))
            && get(/databases/$(database)/documents/invites/$(resource.data.invitationToken)).data.email == request.auth.token.email
            && get(/databases/$(database)/documents/invites/$(resource.data.invitationToken)).data.whitelabelId == whitelabelId
          );
      }

      match /patients/{patientId} {
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || therapistCanAccessPatient(whitelabelId)
          );
        allow create: if tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || therapistCanWritePatient(whitelabelId)
          );
        allow update: if existingTenantFieldIsValid(whitelabelId)
          && tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || therapistCanWritePatient(whitelabelId)
          );
        allow delete: if isGestor(whitelabelId);
      }

      match /therapists/{therapistId} {
        allow read: if isAdminGlobal() || isActiveMember(whitelabelId);
        allow create: if isGestor(whitelabelId)
          || (
            signedIn()
            && whitelabelId == 'individual_' + request.auth.uid
            && therapistId == request.auth.token.email
            && request.resource.data.email == request.auth.token.email
          );
        allow update, delete: if isGestor(whitelabelId);
      }

      match /appointments/{appointmentId} {
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || (
              isTerapeuta(whitelabelId)
              && (
                resource.data.therapistId == request.auth.token.email
                || resource.data.therapistId == request.auth.uid
                || (
                  memberData(whitelabelId).therapistId is string
                  && resource.data.therapistId == memberData(whitelabelId).therapistId
                )
              )
            )
          );
        allow create: if tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || (
              isTerapeuta(whitelabelId)
              && (
                request.resource.data.therapistId == request.auth.token.email
                || request.resource.data.therapistId == request.auth.uid
                || (
                  memberData(whitelabelId).therapistId is string
                  && request.resource.data.therapistId == memberData(whitelabelId).therapistId
                )
              )
            )
          );
        allow update: if existingTenantFieldIsValid(whitelabelId)
          && tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
            || (
              isTerapeuta(whitelabelId)
              && (
                request.resource.data.therapistId == request.auth.token.email
                || request.resource.data.therapistId == request.auth.uid
                || (
                  memberData(whitelabelId).therapistId is string
                  && request.resource.data.therapistId == memberData(whitelabelId).therapistId
                )
              )
            )
          );
        allow delete: if isGestor(whitelabelId) || isRecepcao(whitelabelId);
      }

      match /evolutions/{evolutionId} {
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isTerapeuta(whitelabelId)
          );
        allow create, update: if tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isTerapeuta(whitelabelId)
          );
        allow delete: if isGestor(whitelabelId);
      }

      match /anamneses/{anamneseId} {
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isTerapeuta(whitelabelId)
          );
        allow create, update: if tenantFieldIsValid(whitelabelId)
          && (
            isGestor(whitelabelId)
            || isTerapeuta(whitelabelId)
          );
        allow delete: if isGestor(whitelabelId);
      }

      match /auditLogs/{auditLogId} {
        allow read: if isAdminGlobal() || isGestor(whitelabelId);
        allow create: if signedIn() && isActiveMember(whitelabelId);
        allow update, delete: if false;
      }

      // Escrita anonima permitida SOMENTE aqui e somente para create.
      match /leads/{leadId} {
        allow create: if isValidLeadCreate(whitelabelId);
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
          );
        allow update: if existingTenantFieldIsValid(whitelabelId)
          && tenantFieldIsValid(whitelabelId)
          && isValidLeadTriage()
          && (
            isAdminGlobal()
            || isGestor(whitelabelId)
            || isRecepcao(whitelabelId)
          );
        allow delete: if isAdminGlobal() || isGestor(whitelabelId);
      }

      // Escrita anonima permitida SOMENTE aqui (alem de `leads`) e somente para create.
      match /depoimentosPendentes/{testimonialId} {
        allow create: if isValidTestimonialCreate(whitelabelId);
        allow read: if existingTenantFieldIsValid(whitelabelId)
          && (isAdminGlobal() || isGestor(whitelabelId));
        allow update: if existingTenantFieldIsValid(whitelabelId)
          && tenantFieldIsValid(whitelabelId)
          && isValidTestimonialTriage()
          && (isAdminGlobal() || isGestor(whitelabelId));
        allow delete: if isAdminGlobal() || isGestor(whitelabelId);
      }

      // Conteudo da landing page: leitura publica por definicao.
      match /siteContent/{docId} {
        allow read: if true;
        allow write: if tenantFieldIsValid(whitelabelId)
          && (isAdminGlobal() || isGestor(whitelabelId));
      }
    }

    // Bloqueia colecoes globais antigas de dados sensiveis depois da migracao.
    match /patients/{document=**} {
      allow read, write: if false;
    }

    match /therapists/{document=**} {
      allow read, write: if false;
    }

    match /appointments/{document=**} {
      allow read, write: if false;
    }

    match /evolutions/{document=**} {
      allow read, write: if false;
    }

    match /anamneses/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
